# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> frankenphp/runtime ###
APP_RUNTIME=Symfony\Component\Runtime\SymfonyRuntime
FRANKENPHP_CONFIG=""
###< frankenphp/runtime ###

###> doctrine/doctrine-bundle ###
POSTGRES_USER=symfony_user
POSTGRES_PASSWORD=secret_pg_pass
POSTGRES_DB=steelsync_db
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> doctrine/mongodb-odm-bundle ###
MONGO_USER=mongo_user
MONGO_PASSWORD=secret_mongo_pass
MONGO_DB=steelsync_mongo
MONGO_URL="mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongo:27017/${MONGO_DB}?authSource=admin"
###< doctrine/mongodb-odm-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_this_passphrase_for_production_use
###< lexik/jwt-authentication-bundle ###

# --- Future Features Infrastructure ---

# Valkey / Redis Session Storage
VALKEY_URL=redis://valkey:6379

# RabbitMQ / Symfony Messenger Broker
RABBIT_USER=rabbit_user
RABBIT_PASSWORD=secret_rabbit_pass
MESSENGER_TRANSPORT_DSN="amqp://${RABBIT_USER}:${RABBIT_PASSWORD}@rabbitmq:5672/%2f/messages"
